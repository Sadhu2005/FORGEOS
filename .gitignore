.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Benchmark raw output is regenerated by re-running bench.py; keep the
# markdown reports (summaries) but don't track the raw per-run JSON dumps.
benchmarks/phase0/results/*.json
!benchmarks/phase0/results/.gitkeep

# Managed project sandboxes (keep directory via .gitkeep)
projects/*
!projects/.gitkeep

# Per-project FORGEOS runtime (when nested under a tracked path)
**/.forge/state.local.yaml
**/.forge/*.db

.env
*.log
